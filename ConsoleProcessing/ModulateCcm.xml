    <expected_snr_db>44.3</expected_snr_db>
  </test>

  <test name="16QAM random 15MB">
    <modulation>16QAM</modulation>
    <file>D:\signals\modulation\mod_test\random_16QAM 0.000000MHz 4000.000KHz.pcm</file>
    <command>"D:\PetWave\AquaWave\x64\Debug\AquaWave.exe" -modulate --type 16QAM --out_path "D:\signals\modulation\mod_test\random_16QAM 0.000000MHz 4000.000KHz.pcm" --sym_rate 1000000 --out_size 15728640</command>
    <expected_snr_db>42.2</expected_snr_db>
  </test>

  <test name="32QAM random 15MB">
    <modulation>32QAM</modulation>

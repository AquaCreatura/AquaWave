/* ============================================================
   BLUE BASE THEME — ORANGE ACCENTS
   Base #9FBAD6, input surfaces #EAF3FB, orange accents
   ============================================================ */

/* Палитра:
   base:            #9FBAD6
   base hover:      #4A96D8
   base pressed:    #3B84C4
   base border:     #2470B0   (усиленный синий, для GroupBox и активных рамок)
   on-base text:    #FFFFFF
   on-base muted:   #DCECF9

   input bg:        #EAF3FB   (нежно-голубой)
   input bg hover:  #DCECF9
   input text:      #1F2D3A
   input border:    #4A96D8
   input focus:     #FF9F43

   surface (таблицы): #FFFFFF
   surface alt:       #F5FAFF

   orange:          #FF9F43
   orange hover:    #FFB266
   orange pressed:  #E8892E

   disabled на base:  text #8EAFC8
   disabled в поле:   bg #C8D9E6, text #7A8FA5, border #A0BAD0
   disabled orange:   bg #D0B090, text #4A3520, border #B89A70
   ------------------------------------------------------------ */


/* ========================  GLOBAL  ======================== */

QMainWindow,
QWidget {
    background-color: #9FBAD6;
    color: #FFFFFF;
    font-family: "Segoe UI", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    selection-background-color: #FF9F43;
    selection-color: #1F2D3A;
}


/* ========================  BUTTONS  ======================== */

QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #FFFFFF;
    padding: 3px 6px;
    font-weight: 500;
    text-align: left;
}

QPushButton:hover {
    background-color: #4A96D8;
}

QPushButton:pressed {
    background-color: #3B84C4;
}

QPushButton:disabled {
    color: #8EAFC8;
}

QPushButton:checked {
    background-color: #FF9F43;
    color: #1F2D3A;
}

QPushButton:checked:hover {
    background-color: #FFB266;
}

QPushButton:checked:pressed {
    background-color: #E8892E;
}

QPushButton:checked:disabled {
    background-color: #D0B090;
    color: #4A3520;
}

QPushButton[accent="true"] {
    background-color: #FF9F43;
    color: #1F2D3A;
}

QPushButton[accent="true"]:hover {
    background-color: #FFB266;
}

QPushButton[accent="true"]:pressed {
    background-color: #E8892E;
}

QPushButton[accent="true"]:disabled {
    background-color: #D0B090;
    color: #4A3520;
}


/* ========================  LINE / TEXT EDIT  ======================== */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #EAF3FB;
    border: 1px solid #4A96D8;
    border-radius: 8px;
    color: #1F2D3A;
    padding: 6px 10px;
    placeholder-text-color: #7A8FA5;
    selection-background-color: #FF9F43;
    selection-color: #1F2D3A;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background-color: #E1EFFA;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #FF9F43;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #C8D9E6;
    color: #7A8FA5;
    border: 1px solid #A0BAD0;
}


/* ========================  SPIN BOX  ======================== */

QSpinBox,
QDoubleSpinBox {
    background-color: #EAF3FB;
    border: 1px solid #4A96D8;
    border-radius: 8px;
    color: #1F2D3A;
    padding: 5px 8px;
    selection-background-color: #FF9F43;
    selection-color: #1F2D3A;
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    background-color: #E1EFFA;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #FF9F43;
}

QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #C8D9E6;
    color: #7A8FA5;
    border: 1px solid #A0BAD0;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 18px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #DCECF9;
    border-radius: 4px;
}

QSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:disabled,
QSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:disabled {
    background-color: transparent;
}


/* ========================  COMBO BOX  ======================== */

QComboBox {
    background-color: #EAF3FB;
    border: 1px solid #4A96D8;
    border-radius: 6px;
    padding: 6px 12px;
    padding-right: 24px;
    color: #1F2D3A;
    min-height: 20px;
}

QComboBox:hover {
    background-color: #E1EFFA;
}

QComboBox:focus {
    border: 1px solid #FF9F43;
}

QComboBox:disabled {
    background-color: #C8D9E6;
    color: #7A8FA5;
    border: 1px solid #A0BAD0;
}

QComboBox::drop-down {
    border: none;
    width: 0px;
}

/* Выпадающий список — в тон полю */
QComboBox QAbstractItemView {
    background-color: #EAF3FB;
    border: 1px solid #4A96D8;
    border-radius: 6px;
    color: #1F2D3A;
    selection-background-color: #FF9F43;
    selection-color: #1F2D3A;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    min-height: 24px;
    color: #1F2D3A;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #FF9F43;
    color: #1F2D3A;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #DCECF9;
    color: #1F2D3A;
}


/* ========================  CHECKBOX / RADIO  ======================== */

QCheckBox,
QRadioButton {
    color: #FFFFFF;
    spacing: 8px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #8EAFC8;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid #4A96D8;
    background-color: #EAF3FB;
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 10px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #FF9F43;
}

QCheckBox::indicator:checked {
    background-color: #FF9F43;
    border-color: #FF9F43;
}

QRadioButton::indicator:checked {
    background-color: #FF9F43;
    border-color: #FF9F43;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: #C8D9E6;
    border-color: #A0BAD0;
}

QCheckBox::indicator:checked:disabled,
QRadioButton::indicator:checked:disabled {
    background-color: #D0B090;
    border-color: #B89A70;
}


/* ========================  SCROLL BAR  ======================== */

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #3B84C4;
    border-radius: 5px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2F6EA6;
}

QScrollBar::handle:vertical:disabled {
    background-color: #7CB8E0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #3B84C4;
    border-radius: 5px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #2F6EA6;
}

QScrollBar::handle:horizontal:disabled {
    background-color: #7CB8E0;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}


/* ========================  TAB WIDGET  ======================== */

QTabWidget::pane {
    background-color: #9FBAD6;
    border: 1px solid #4A96D8;
    border-radius: 10px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    border: none;
    color: #DCECF9;
    padding: 8px 20px;
    border-radius: 8px;
    margin: 2px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background-color: #4A96D8;
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #EAF3FB;
    color: #1F2D3A;
    border: 1px solid #4A96D8;
}

QTabBar::tab:selected:hover {
    background-color: #DCECF9;
}

QTabBar::tab:disabled {
    color: #8EAFC8;
}

QTabBar::tab:selected:disabled {
    background-color: #C8D9E6;
    color: #7A8FA5;
}


/* ========================  MENU  ======================== */

QMenuBar {
    background-color: #9FBAD6;
    border: none;
    color: #FFFFFF;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    border-radius: 6px;
    padding: 5px 12px;
}

QMenuBar::item:selected {
    background-color: #4A96D8;
}

QMenuBar::item:disabled {
    color: #8EAFC8;
}

QMenu {
    background-color: #9FBAD6;
    border: 1px solid #4A96D8;
    border-radius: 10px;
    padding: 6px;
    color: #FFFFFF;
}

QMenu::item {
    padding: 7px 28px 7px 14px;
    border-radius: 6px;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: #FF9F43;
    color: #1F2D3A;
}

QMenu::item:disabled {
    color: #8EAFC8;
}

QMenu::separator {
    height: 1px;
    background-color: #4A96D8;
    margin: 4px 10px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}


/* ========================  TABLE / TREE / LIST  ======================== */

QTableView,
QTreeView,
QListView {
    background-color: #FFFFFF;
    alternate-background-color: #F5FAFF;
    border: 1px solid #4A96D8;
    border-radius: 10px;
    color: #1F2D3A;
    gridline-color: #D4E4F2;
    selection-background-color: #FFE3C7;
    selection-color: #1F2D3A;
}

QTableView::item,
QTreeView::item,
QListView::item {
    padding: 5px 8px;
    border: none;
}

QTableView::item:hover,
QTreeView::item:hover,
QListView::item:hover {
    background-color: #E4F1FB;
}

QTableView::item:selected,
QTreeView::item:selected,
QListView::item:selected {
    background-color: #FFE3C7;
    color: #1F2D3A;
}

QTableView:disabled,
QTreeView:disabled,
QListView:disabled {
    background-color: #E4EEF6;
    color: #7A8FA5;
    border: 1px solid #A0BAD0;
}

QTableView::item:disabled,
QTreeView::item:disabled,
QListView::item:disabled {
    color: #7A8FA5;
}

QHeaderView::section {
    background-color: #EAF3FB;
    color: #3A4D5E;
    border: none;
    border-bottom: 1px solid #4A96D8;
    border-right: 1px solid #D4E4F2;
    padding: 6px 10px;
    font-weight: 600;
    font-size: 11px;
}

QHeaderView::section:disabled {
    background-color: #C8D9E6;
    color: #7A8FA5;
}


/* ========================  GROUP BOX  ======================== */

QGroupBox {
    background-color: #9FBAD6;
    border: 2px solid #2470B0;
    border-radius: 10px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
    font-weight: 600;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 2px;
    padding: 0 6px;
    color: #FFFFFF;
    font-size: 11px;
}

QGroupBox QLabel,
QGroupBox QCheckBox,
QGroupBox QRadioButton {
    background-color: transparent;
    color: #FFFFFF;
}

QGroupBox QCheckBox:disabled,
QGroupBox QRadioButton:disabled,
QGroupBox QLabel:disabled {
    color: #8EAFC8;
}

QGroupBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #EAF3FB;
    border: 1.5px solid #4A96D8;
    border-radius: 4px;
}

QGroupBox::indicator:checked {
    background-color: #FF9F43;
    border-color: #FF9F43;
}

QGroupBox::indicator:disabled {
    background-color: #C8D9E6;
    border-color: #A0BAD0;
}


/* ========================  SLIDER  ======================== */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #DCECF9;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background-color: #EAF3FB;
    border: 1.5px solid #FF9F43;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #FFFFFF;
    border-color: #FFB266;
}

QSlider::sub-page:horizontal {
    background-color: #FF9F43;
    border-radius: 2px;
}

QSlider::handle:horizontal:disabled {
    background-color: #C8D9E6;
    border-color: #A0BAD0;
}

QSlider::sub-page:horizontal:disabled {
    background-color: #D0B090;
}

QSlider::groove:vertical {
    width: 4px;
    background-color: #DCECF9;
    border-radius: 2px;
}

QSlider::handle:vertical {
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    background-color: #EAF3FB;
    border: 1.5px solid #FF9F43;
    border-radius: 9px;
}

QSlider::handle:vertical:hover {
    background-color: #FFFFFF;
    border-color: #FFB266;
}

QSlider::handle:vertical:disabled {
    background-color: #C8D9E6;
    border-color: #A0BAD0;
}


/* ========================  PROGRESS BAR  ======================== */

QProgressBar {
    background-color: #DCECF9;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #FF9F43;
    border-radius: 4px;
}

QProgressBar:disabled {
    background-color: #A9C7E0;
}

QProgressBar::chunk:disabled {
    background-color: #D0B090;
}


/* ========================  TOOL TIP  ======================== */

QToolTip {
    background-color: #1F2D3A;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
}


/* ========================  TOOL BAR  ======================== */

QToolBar {
    background-color: #9FBAD6;
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    width: 1px;
    background-color: #4A96D8;
    margin: 6px 4px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    color: #FFFFFF;
}

QToolButton:hover {
    background-color: #4A96D8;
}

QToolButton:pressed {
    background-color: #3B84C4;
}

QToolButton:checked {
    background-color: #FF9F43;
    color: #1F2D3A;
}

QToolButton:disabled {
    color: #8EAFC8;
}

QToolButton:checked:disabled {
    background-color: #D0B090;
    color: #4A3520;
}


/* ========================  STATUS BAR  ======================== */

QStatusBar {
    background-color: #9FBAD6;
    border: none;
    color: #DCECF9;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

QStatusBar:disabled {
    color: #8EAFC8;
}


/* ========================  DOCK WIDGET  ======================== */

QDockWidget {
    color: #FFFFFF;
}

QDockWidget::title {
    background-color: #9FBAD6;
    border: none;
    padding: 8px 12px;
    text-align: left;
    font-weight: 600;
    font-size: 12px;
    color: #DCECF9;
}

QDockWidget::title:disabled {
    color: #8EAFC8;
}


/* ========================  SPLITTER  ======================== */

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QSplitter::handle:vertical {
    height: 6px;
}

QSplitter::handle:hover {
    background-color: #4A96D8;
    border-radius: 3px;
}


/* ========================  FRAME / SEPARATOR  ======================== */

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #4A96D8;
    max-height: 1px;
}


/* ========================  DIALOG  ======================== */

QDialog {
    background-color: #9FBAD6;
}


/* ========================  DATE / TIME EDIT  ======================== */

QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: #EAF3FB;
    border: 1px solid #4A96D8;
    border-radius: 8px;
    color: #1F2D3A;
    padding: 6px 10px;
    selection-background-color: #FF9F43;
    selection-color: #1F2D3A;
}

QDateEdit:hover,
QTimeEdit:hover,
QDateTimeEdit:hover {
    background-color: #E1EFFA;
}

QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border: 1px solid #FF9F43;
}

QDateEdit:disabled,
QTimeEdit:disabled,
QDateTimeEdit:disabled {
    background-color: #C8D9E6;
    color: #7A8FA5;
    border: 1px solid #A0BAD0;
}

QDateEdit::drop-down,
QTimeEdit::drop-down,
QDateTimeEdit::drop-down {
    border: none;
    width: 24px;
}

QDateEdit::drop-down:disabled,
QTimeEdit::drop-down:disabled,
QDateTimeEdit::drop-down:disabled {
    background-color: transparent;
}


/* ========================  CALENDAR  ======================== */

QCalendarWidget {
    background-color: #EAF3FB;
    border: 1px solid #4A96D8;
    border-radius: 10px;
}

QCalendarWidget:disabled {
    background-color: #C8D9E6;
    border: 1px solid #A0BAD0;
}

QCalendarWidget QToolButton {
    color: #1F2D3A;
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton:hover {
    background-color: #DCECF9;
}

QCalendarWidget QToolButton:disabled {
    color: #7A8FA5;
}

QCalendarWidget QAbstractItemView {
    background-color: #EAF3FB;
    color: #1F2D3A;
    selection-background-color: #FF9F43;
    selection-color: #1F2D3A;
}

QCalendarWidget QAbstractItemView:disabled {
    background-color: #C8D9E6;
    color: #7A8FA5;
}


/* ========================  STACKED WIDGET  ======================== */

QStackedWidget {
    background-color: transparent;
}
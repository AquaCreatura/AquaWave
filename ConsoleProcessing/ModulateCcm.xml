<?xml version="1.0" encoding="UTF-8"?>
<!--
  AquaWave: console generation of test signals with random symbols (ModTester, -modulate mode).

  How to use:
    1. Copy a <command> line into cmd/PowerShell and run it.
    2. The command writes a 15 MB (15728640 bytes) baseband int16 complex .pcm file
       with random symbols for the given modulation into D:\signals\modulation\mod_test.
       If the input data file is missing, ModTester generates a random one itself
       (so the command is self-contained).

  Build: x64 Debug -> D:\PetWave\AquaWave\x64\Debug\AquaWave.exe
  Each signal: 4 samples/symbol, carrier 0 (baseband), sample rate = symbol rate * 4.
  The file name carries carrier and sample rate ("<comment> 0.000000MHz 4000.000KHz.pcm"),
  so -dmd can parse them when file_fc/file_sr are omitted.

  Note: the console accepts single-dash long options (-type is accepted like the
  double-dash form), so option names are written with a single dash here to keep
  this XML comment valid. The command elements below use the normal double dash.

  Demodulation of a generated signal (QPSK example; loop speeds and the equaliser
  algorithm default to the optimal per-modulation set - see aq_demod::GetDefaultSliderSetup;
  for 512/1024QAM the blind MMA equaliser is used by default):
    "D:\PetWave\AquaWave\x64\Debug\AquaWave.exe" -dmd -type QPSK -file_path "D:\signals\modulation\mod_test\random_QPSK 0.000000MHz 4000.000KHz.pcm" -file_fc 0 -file_sr 4000000 -dmd_fc 0 -dmd_sr 1000000

  Add noise to a signal with -noise <dB> (e.g. -noise -30 for SNR = 30 dB).
  The signals below are noise-free; expected_snr_db is the clean-signal demodulation SNR.
-->
<ModulateCcm>

  <test name="BPSK random 15MB">
    <modulation>BPSK</modulation>
    <file>D:\signals\modulation\mod_test\random_BPSK 0.000000MHz 4000.000KHz.pcm</file>
    <command>"D:\PetWave\AquaWave\x64\Debug\AquaWave.exe" -modulate --type BPSK --out_path "D:\signals\modulation\mod_test\random_BPSK 0.000000MHz 4000.000KHz.pcm" --sym_rate 1000000 --out_size 15728640</command>
    <expected_snr_db>43.3</expected_snr_db>
  </test>

  <test name="QPSK random 15MB">
    <modulation>QPSK</modulation>
    <file>D:\signals\modulation\mod_test\random_QPSK 0.000000MHz 4000.000KHz.pcm</file>
    <command>"D:\PetWave\AquaWave\x64\Debug\AquaWave.exe" -modulate --type QPSK --out_path "D:\signals\modulation\mod_test\random_QPSK 0.000000MHz 4000.000KHz.pcm" --sym_rate 1000000 --out_size 15728640</command>
    <expected_snr_db>44.6</expected_snr_db>
  </test>

  <test name="8PSK random 15MB">
    <modulation>8PSK</modulation>
    <file>D:\signals\modulation\mod_test\random_8PSK 0.000000MHz 4000.000KHz.pcm</file>
